# ── Secretos y claves ───────────────────────────────────────
# Solo se versionan las plantillas (.env.example y deploy/env.prod.example), sin valores.
.env
.env.*
!.env.example
*.pem
*.key
*.ppk
*.p12
*.pfx
id_rsa*
id_ed25519*
.claude/settings.local.json

# ── Datos y respaldos (pesados; se regeneran o se descargan) ─
data/
*.bak
*.bacpac
deploy/backup/

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# ── Java / Spring Boot ──────────────────────────────────────
target/
*.class
*.log

# ── Node / Angular ──────────────────────────────────────────
node_modules/
dist/
.angular/

# ── Despliegue ──────────────────────────────────────────────
# Paquete armado para Hugging Face (copia del jar, el sitio y el respaldo de la base).
deploy/hf/space/

# ── Video de presentación (pitch-video) ─────────────────────
# Videos finales y renders: se comparten por enlace, no por git.
pitch-video/out/
# Fotos de prensa de terceros: no se redistribuyen en el repositorio.
pitch-video/public/noticia*.jpg

# ── Editores y sistema ──────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Capturas de revisión de diseño ──────────────────────────
.impeccable/review/
