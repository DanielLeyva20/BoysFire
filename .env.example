# Copia este archivo como ".env" y completa los valores.

# ── NASA FIRMS ─────────────────────────────────────────────
# Key gratuita: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=9bdfdfd1f642b971412218e79b9b2864

# ── SQL Server (contenedor Docker) ─────────────────────────
# Mínimo 8 caracteres con mayúsculas, minúsculas y números. Solo letras y números.
MSSQL_SA_PASSWORD=
DB_HOST=127.0.0.1
# Puerto en tu PC. Usa uno libre: el 1433 suele estar ocupado por un SQL Server local.
DB_PORT=14330
DB_NAME=boysfire
DB_APP_USER=boysfire_app
DB_APP_PASSWORD=

# ── Operación (panel de monitoreo) ─────────────────────────
# Clave del panel de operadores. Elige una larga y no la compartas.
OPERATOR_KEY=
# Dirección pública de la aplicación (se usa en los enlaces de las alertas).
PUBLIC_APP_URL=http://localhost:4200

# ── Telegram (alertas) ─────────────────────────────────────
# Token que entrega @BotFather. Sin token, los envíos se registran como simulados.
TELEGRAM_BOT_TOKEN=
