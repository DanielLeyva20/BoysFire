# Copia este archivo a deploy/.env en la VM y rellena los valores.
# Usa contraseñas NUEVAS (no las de desarrollo). Genera una con:  openssl rand -base64 24 | tr -d '/+='
SITE_ADDRESS=boysfire.duckdns.org
MSSQL_SA_PASSWORD=
DB_NAME=boysfire
DB_APP_USER=boysfire_app
DB_APP_PASSWORD=
OPERATOR_KEY=
TELEGRAM_BOT_TOKEN=
# Memoria de SQL Server: 3072 en una VM de 4 GB con swap; 4096 o más si la VM tiene 8 GB.
MSSQL_MEMORY_LIMIT_MB=3072
